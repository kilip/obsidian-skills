# Gmail Accounts
GOG_ACCOUNT=you@gmail.com

# Email Automation (email-reader & email-processor)
OS_INBOX_PATH=~/vault/inbox
OS_GOG_BIN=gog
OS_GEMINI_MODEL=gemini-2.5-flash-lite

# Google Drive Sync (Optional)
OS_GDRIVE_DB_PATH=~/.obsidian-skills/gdrive/index.db
OS_GDRIVE_GOG_BIN=gog
OS_GDRIVE_LOG_PATH=~/.obsidian-skills/gdrive/gdrive.log
OS_GDRIVE_DRY_RUN=0
OS_GDRIVE_PAGE_DELAY=0.1
OS_GDRIVE_BRIEF_DELAY=0.5
